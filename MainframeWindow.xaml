<Window x:Class="DesktopCompanion.MainframeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anya Mainframe"
        Width="600" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8E8EE"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="Foreground" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF9EBC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="#FFB7C5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8E8EE"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="Foreground" Value="#FFB7C5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#FFB7C5"/>
        </Style>
    </Window.Resources>

    <!-- Outer Obsidian & Pastel Pink Frame -->
    <Border Background="#09090E" BorderBrush="#FFB7C5" BorderThickness="2" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <!-- Background Falling Snow Canvas -->
            <Canvas x:Name="SnowCanvas" IsHitTestVisible="False" Opacity="0.55"/>

            <!-- Main Content Layout -->
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom Drag Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❄️ ANYA MAINFRAME" FontSize="19" FontWeight="ExtraBold" Foreground="#FFB7C5"/>
                        <TextBlock Text=" // SYSTEM &amp; TELEPATHY CONTROL" FontSize="12" Foreground="#9E7B88" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </StackPanel>
                    <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right"
                            Background="#1A1A26" Foreground="#FFB7C5" BorderBrush="#FFB7C5" BorderThickness="1"
                            Width="28" Height="28" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <!-- 4 Tabs: BRAIN, VOICE, PERSONALITY, ANYA & PHYSICS -->
                <TabControl Grid.Row="1" Background="#CC0F0F17" BorderBrush="#4DFFB7C5" BorderThickness="1" Padding="6">

                    <!-- TAB 1: BRAIN -->
                    <TabItem Header=" 🧠 BRAIN ">
                        <StackPanel Margin="12">
                            <TextBlock Text="AI Provider Preset:" Foreground="#FFB7C5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ProviderCombo" SelectionChanged="ProviderCombo_SelectionChanged" Padding="6" Margin="0,0,0,10">
                                <ComboBoxItem Content="Ollama (Local - Free)"/>
                                <ComboBoxItem Content="OpenRouter (Cloud)"/>
                                <ComboBoxItem Content="Google Gemini (OpenAI Compat)"/>
                                <ComboBoxItem Content="OpenAI (Official)"/>
                                <ComboBoxItem Content="Custom Endpoint"/>
                            </ComboBox>

                            <TextBlock Text="API Endpoint URL:" Margin="0,0,0,4"/>
                            <TextBox x:Name="EndpointBox" Margin="0,0,0,10"/>

                            <TextBlock Text="API Key (use 'ollama' for local):" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="ApiKeyBox" Background="#12121A" Foreground="#FFF0F5" BorderBrush="#FF9EBC" Padding="7,5" Margin="0,0,0,10"/>

                            <TextBlock Text="Model Name (e.g. gemma3:4b, gemini-2.5-flash, gpt-4o-mini):" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModelBox" Margin="0,0,0,10"/>

                            <CheckBox x:Name="TelepathyCheck" Content="Enable Telepathy (Allow Anya to see active window titles on your PC)"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="⚡ Test Brain" Click="TestBrain_Click" Background="#241620" Foreground="#FFB7C5" BorderBrush="#FFB7C5" BorderThickness="1" Padding="14,6" Cursor="Hand"/>
                                <TextBlock x:Name="BrainStatusText" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFB7C5"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 2: VOICE -->
                    <TabItem Header=" 🔊 VOICE ">
                        <StackPanel Margin="12">
                            <CheckBox x:Name="EnableVoiceCheck" Content="Enable Anya Voice Output (TTS)" FontWeight="SemiBold" Foreground="#FFB7C5"/>

                            <TextBlock Text="Voice Engine / Provider:" Margin="0,8,0,4"/>
                            <ComboBox x:Name="TtsProviderCombo" SelectionChanged="TtsProviderCombo_SelectionChanged" Padding="6" Margin="0,0,0,10">
                                <ComboBoxItem Content="Windows Built-in (Instant / Offline)"/>
                                <ComboBoxItem Content="Kokoro / Piper Local Server (OpenAI Compat)"/>
                                <ComboBoxItem Content="OpenAI TTS (Cloud)"/>
                                <ComboBoxItem Content="Fish Audio / Custom HTTP Endpoint"/>
                            </ComboBox>

                            <TextBlock Text="TTS Endpoint URL:" Margin="0,0,0,4"/>
                            <TextBox x:Name="TtsEndpointBox" Margin="0,0,0,10"/>

                            <TextBlock Text="TTS API Key (optional for local):" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="TtsKeyBox" Background="#12121A" Foreground="#FFF0F5" BorderBrush="#FF9EBC" Padding="7,5" Margin="0,0,0,10"/>

                            <TextBlock Text="Voice ID / Reference ID (e.g. Fish Audio ID or af_bella):" Margin="0,0,0,4"/>
                            <TextBox x:Name="TtsVoiceIdBox" Margin="0,0,0,10"/>

                            <TextBlock x:Name="VolumeLabel" Text="Voice Volume: 85%" Margin="0,0,0,4"/>
                            <Slider x:Name="VolumeSlider" Minimum="0.0" Maximum="1.0" Value="0.85" ValueChanged="Sliders_ValueChanged" Margin="0,0,0,10"/>

                            <Button Content="🔊 Test Anya's Voice ('Waku waku!')" Click="TestVoice_Click" HorizontalAlignment="Left" Background="#241620" Foreground="#FFB7C5" BorderBrush="#FFB7C5" BorderThickness="1" Padding="14,6" Cursor="Hand"/>
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 3: PERSONALITY -->
                    <TabItem Header=" 🎭 PERSONALITY ">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Anya's Character Prompt &amp; Speaking Rules:" Foreground="#FFB7C5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="PersonalityBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <Button Grid.Row="2" Content="🔄 Restore Default Anya Forger Prompt" Click="ResetPersonality_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Background="#241620" Foreground="#FFB7C5" BorderBrush="#FFB7C5" BorderThickness="1" Padding="12,6" Cursor="Hand"/>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: ANYA & PHYSICS -->
                    <TabItem Header=" 🥜 ANYA &amp; PHYSICS ">
                        <StackPanel Margin="12">
                            <TextBlock x:Name="ScaleLabel" Text="Anya Size (Scale): 100%" Foreground="#FFB7C5" Margin="0,0,0,4"/>
                            <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="Sliders_ValueChanged" Margin="0,0,0,10"/>

                            <TextBlock x:Name="GravityLabel" Text="Gravity Strength: 0.85" Foreground="#FFB7C5" Margin="0,0,0,4"/>
                            <Slider x:Name="GravitySlider" Minimum="0.2" Maximum="2.0" Value="0.85" ValueChanged="Sliders_ValueChanged" Margin="0,0,0,10"/>

                            <TextBlock x:Name="MusicLabel" Text="Music Dance Sensitivity (Spotify / Music Apps): 0.04" Foreground="#FFB7C5" Margin="0,0,0,4"/>
                            <Slider x:Name="MusicSlider" Minimum="0.01" Maximum="0.30" Value="0.04" ValueChanged="Sliders_ValueChanged" Margin="0,0,0,10"/>

                            <TextBlock Text="Target Frame Rate (FPS Lock):" Foreground="#FFB7C5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FpsCombo" Padding="6" Margin="0,0,0,10">
                                <ComboBoxItem Content="60 FPS"/>
                                <ComboBoxItem Content="90 FPS"/>
                                <ComboBoxItem Content="120 FPS"/>
                                <ComboBoxItem Content="144 FPS"/>
                                <ComboBoxItem Content="240 FPS"/>
                                <ComboBoxItem Content="260 FPS"/>
                            </ComboBox>

                            <CheckBox x:Name="WalkCheck" Content="Autonomous walking &amp; whistling on desktop"/>
                            <CheckBox x:Name="TopmostCheck" Content="Keep Anya always on top of other windows"/>
                            <CheckBox x:Name="SnowCheck" Content="Enable falling snow animation inside Anya Mainframe" Checked="SnowCheck_Changed" Unchecked="SnowCheck_Changed"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Footer Save Bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <TextBlock x:Name="SaveStatusText" Text="" Foreground="#FFB7C5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="💾 SAVE &amp; APPLY TO ANYA" Click="SaveButton_Click"
                            Background="#FFB7C5" Foreground="#09090E" FontWeight="ExtraBold"
                            Padding="20,9" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>